  sprintf2 fnf '/tmp/ttl_exh_find_%d.tmp' i
  fileopen ffh fnf 0
  filewriteln ffh 'find test'
  fileclose ffh
next
findfirst found '/tmp/ttl_exh_find_*.tmp'
if result == 0 then
  fcount = 1
  :exh_findloop
  findnext found 0
