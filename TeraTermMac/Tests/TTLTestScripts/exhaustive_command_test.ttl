; ============================================================
; TTL Exhaustive Command Test
;
; TTLCommandReference.md 全コマンド・全引数パターン・
; 境界値(最大/最小)・条件分岐・ループ・ネストを網羅。
; 接続不要のオフラインテスト。
;
; 検証対象: 全25セクション 150+ テストケース
; Results: /tmp/ttl_exhaustive_test.log
; ============================================================

; --- Configuration ---
logfile = '/tmp/ttl_exhaustive_test.log'
pass_count = 0
fail_count = 0
test_num = 0

fileopen fh logfile 0
if fh < 0 then
  end
endif

filewriteln fh '============================================'
filewriteln fh 'TTL Exhaustive Command Test'
getdate datestr
gettime timestr
sprintf2 header 'Run: %s %s' datestr timestr
filewriteln fh header
filewriteln fh '============================================'
filewriteln fh ''

; ############################################################
;  SECTION 1 — Control Flow
; ############################################################
filewriteln fh '=== Section 1: Control Flow ==='

; --- if-then-endif basic true ---
test_num = test_num + 1
x = 1
if x == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] if-then true branch' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] if-then true branch' test_num
endif
filewriteln fh msg

; --- if-then-else false branch ---
test_num = test_num + 1
x = 0
if x == 1 then
  r = 0
else
  r = 1
endif
if r == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] if-else false branch' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] if-else false branch' test_num
endif
filewriteln fh msg

; --- 10-level elseif chain ---
test_num = test_num + 1
x = 8
r = 0
if x == 1 then
  r = 1
elseif x == 2 then
  r = 2
elseif x == 3 then
  r = 3
elseif x == 4 then
  r = 4
elseif x == 5 then
  r = 5
elseif x == 6 then
  r = 6
elseif x == 7 then
  r = 7
elseif x == 8 then
  r = 8
elseif x == 9 then
  r = 9
else
  r = 10
endif
if r == 8 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 10-level elseif x=8' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] 10-level elseif' test_num
endif
filewriteln fh msg

; --- 5-level nested if ---
test_num = test_num + 1
a = 1
b = 2
c = 3
d = 4
e = 5
r = 0
if a == 1 then
  if b == 2 then
    if c == 3 then
      if d == 4 then
        if e == 5 then
          r = 99
        endif
      endif
    endif
  endif
endif
if r == 99 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 5-level nested if' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] 5-level nested if' test_num
endif
filewriteln fh msg

; --- goto forward ---
test_num = test_num + 1
gv = 0
goto skip_gv1
gv = 999
:skip_gv1
if gv == 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] goto forward' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] goto forward' test_num
endif
filewriteln fh msg

; --- goto backward loop ---
test_num = test_num + 1
gc = 0
:back_loop
gc = gc + 1
if gc < 5 then
  goto back_loop
endif
if gc == 5 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] goto backward 5 iter' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] goto backward' test_num
endif
filewriteln fh msg

; --- call/return simple ---
test_num = test_num + 1
sub_flag = 0
call simple_sub1
if sub_flag == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] call/return simple' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] call/return simple' test_num
endif
filewriteln fh msg
goto after_sub1
:simple_sub1
  sub_flag = 1
  return
:after_sub1

; --- call/return 10-level deep ---
test_num = test_num + 1
depth10 = 0
call d1
if depth10 == 10 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 10-level call depth' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] 10-level call depth=%d' test_num depth10' test_num
endif
filewriteln fh msg
goto after_depth10
:d1
  depth10 = depth10 + 1
  call d2
  return
:d2
  depth10 = depth10 + 1
  call d3
  return
:d3
  depth10 = depth10 + 1
  call d4
  return
:d4
  depth10 = depth10 + 1
  call d5
  return
:d5
  depth10 = depth10 + 1
  call d6
  return
:d6
  depth10 = depth10 + 1
  call d7
  return
:d7
  depth10 = depth10 + 1
  call d8
  return
:d8
  depth10 = depth10 + 1
  call d9
  return
:d9
  depth10 = depth10 + 1
  call d10
  return
:d10
  depth10 = depth10 + 1
  return
:after_depth10

; --- ifdefined existing var ---
test_num = test_num + 1
ifd_test_var = 42
ifdefined ifd_test_var
if result == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] ifdefined existing=1' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] ifdefined existing' test_num
endif
filewriteln fh msg

; --- ifdefined non-existing var ---
test_num = test_num + 1
ifdefined no_such_var_xyz
if result == 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] ifdefined missing=0' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] ifdefined missing' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 2 — Loops
; ############################################################
filewriteln fh '=== Section 2: Loops ==='

; --- for/next 1..100 sum ---
test_num = test_num + 1
sum = 0
for i 1 100
  sum = sum + i
next
if sum == 5050 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] for sum(1..100)=5050' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] for sum=%d' test_num sum' test_num
endif
filewriteln fh msg

; --- for/next single iteration ---
test_num = test_num + 1
cnt = 0
for i 5 5
  cnt = cnt + 1
next
if cnt == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] for single iter' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] for single cnt=%d' test_num cnt' test_num
endif
filewriteln fh msg

; --- while/endwhile ---
test_num = test_num + 1
n = 0
while n < 50
  n = n + 1
endwhile
if n == 50 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] while 50 iter' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] while n=%d' test_num n' test_num
endif
filewriteln fh msg

; --- while false (0 iter) ---
test_num = test_num + 1
n = 100
ran = 0
while n < 0
  ran = 1
endwhile
if ran == 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] while false 0 iter' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] while false ran=%d' test_num ran' test_num
endif
filewriteln fh msg

; --- until/enduntil ---
test_num = test_num + 1
cnt2 = 0
until cnt2 >= 10
  cnt2 = cnt2 + 1
enduntil
if cnt2 == 10 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] until count=10' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] until cnt=%d' test_num cnt2' test_num
endif
filewriteln fh msg

; --- do/loop until ---
test_num = test_num + 1
dl = 0
do
  dl = dl + 1
loop until dl >= 25
if dl == 25 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] do-until 25' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] do-until dl=%d' test_num dl' test_num
endif
filewriteln fh msg

; --- do/loop while ---
test_num = test_num + 1
dw = 0
do
  dw = dw + 1
loop while dw < 15
if dw == 15 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] do-while 15' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] do-while dw=%d' test_num dw' test_num
endif
filewriteln fh msg

; --- break from for ---
test_num = test_num + 1
bk = 0
for i 1 1000
  if i == 42 then
    bk = i
    break
  endif
next
if bk == 42 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] break at 42' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] break bk=%d' test_num bk' test_num
endif
filewriteln fh msg

; --- break from while ---
test_num = test_num + 1
bw = 0
while 1
  bw = bw + 1
  if bw == 77 then
    break
  endif
endwhile
if bw == 77 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] break while at 77' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] break while bw=%d' test_num bw' test_num
endif
filewriteln fh msg

; --- continue in for (odd sum) ---
test_num = test_num + 1
oddsum = 0
for i 1 20
  x = i % 2
  if x == 0 then
    continue
  endif
  oddsum = oddsum + i
next
if oddsum == 100 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] continue odd sum=100' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] continue sum=%d' test_num oddsum' test_num
endif
filewriteln fh msg

; --- triple nested for 10*10*10 ---
test_num = test_num + 1
cnt3 = 0
for i 1 10
  for j 1 10
    for k 1 10
      cnt3 = cnt3 + 1
    next
  next
next
if cnt3 == 1000 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] triple nested 1000' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] triple cnt=%d' test_num cnt3' test_num
endif
filewriteln fh msg

; --- mixed for-while-if nesting ---
test_num = test_num + 1
total = 0
for i 1 10
  j = 0
  while j < 5
    if j == 3 then
      total = total + i
    endif
    j = j + 1
  endwhile
next
if total == 55 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] mixed nesting total=55' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] mixed total=%d' test_num total' test_num
endif
filewriteln fh msg

; --- STRESS 10000 iterations ---
test_num = test_num + 1
acc = 0
for i 1 10000
  acc = acc + i
next
if acc == 50005000 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 10000 iter sum=50005000' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] 10000 sum=%d' test_num acc' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 3 — Expressions and Operators
; ############################################################
filewriteln fh '=== Section 3: Expressions and Operators ==='

; --- arithmetic + - * / %% ---
test_num = test_num + 1
a = 123 + 456
b = 456 - 123
c = 13 * 17
d = 100 / 7
e = 100 % 7
ok = 1
if a <> 579 then
  ok = 0
endif
if b <> 333 then
  ok = 0
endif
if c <> 221 then
  ok = 0
endif
if d <> 14 then
  ok = 0
endif
if e <> 2 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] arithmetic +,-,*,/,%%' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] arithmetic failed' test_num
endif
filewriteln fh msg

; --- operator precedence ---
test_num = test_num + 1
x = 2 + 3 * 4
if x == 14 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] precedence 2+3*4=14' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] precedence x=%d' test_num x' test_num
endif
filewriteln fh msg

; --- parenthesized expression ---
test_num = test_num + 1
x = (2 + 3) * 4
if x == 20 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] parens (2+3)*4=20' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] parens x=%d' test_num x' test_num
endif
filewriteln fh msg

; --- deeply nested parentheses ---
test_num = test_num + 1
x = (((((1 + 2) * 3) + 4) * 5) + 6)
if x == 71 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] deep parens=71' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] deep parens=%d' test_num x' test_num
endif
filewriteln fh msg

; --- comparison operators == != < > <= >= ---
test_num = test_num + 1
ok = 1
if (5 == 5) <> 1 then
  ok = 0
endif
if (5 != 6) <> 1 then
  ok = 0
endif
if (3 < 5) <> 1 then
  ok = 0
endif
if (5 > 3) <> 1 then
  ok = 0
endif
if (5 <= 5) <> 1 then
  ok = 0
endif
if (5 >= 5) <> 1 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] all comparison ops' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] comparison ops failed' test_num
endif
filewriteln fh msg

; --- <> not equal operator ---
test_num = test_num + 1
x = 5
if x <> 6 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] <> operator works' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] <> operator' test_num
endif
filewriteln fh msg

; --- logical AND OR ---
test_num = test_num + 1
a = (1 && 1)
b = (1 && 0)
c = (0 || 1)
d = (0 || 0)
ok = 1
if a <> 1 then
  ok = 0
endif
if b <> 0 then
  ok = 0
endif
if c <> 1 then
  ok = 0
endif
if d <> 0 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] logical AND/OR' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] logical AND/OR' test_num
endif
filewriteln fh msg

; --- bitwise & | ^ ---
test_num = test_num + 1
a = $FF & $0F
b = $F0 | $0F
c = $FF ^ $0F
ok = 1
if a <> $0F then
  ok = 0
endif
if b <> $FF then
  ok = 0
endif
if c <> $F0 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] bitwise &|^' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] bitwise &|^' test_num
endif
filewriteln fh msg

; --- shift << >> >>> ---
test_num = test_num + 1
a = 1 << 8
b = 256 >> 4
ok = 1
if a <> 256 then
  ok = 0
endif
if b <> 16 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] shift <</>>=256/16' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] shift ops' test_num
endif
filewriteln fh msg

; --- INT32 max 2147483647 ---
test_num = test_num + 1
x = 2147483647
if x == 2147483647 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] INT32 max' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] INT32 max' test_num
endif
filewriteln fh msg

; --- hex $7FFFFFFF = INT32 max ---
test_num = test_num + 1
x = $7FFFFFFF
if x == 2147483647 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] hex $7FFFFFFF' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] hex $7FFFFFFF' test_num
endif
filewriteln fh msg

; --- negative value ---
test_num = test_num + 1
x = 0 - 100
if x == (0 - 100) then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] negative -100' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] negative value' test_num
endif
filewriteln fh msg

; --- zero value ---
test_num = test_num + 1
x = 0
if x == 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] zero' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] zero' test_num
endif
filewriteln fh msg

; --- char code literals #65#66#67 ---
test_num = test_num + 1
s = #65#66#67
if s == 'ABC' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] char codes ABC' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] char codes' test_num
endif
filewriteln fh msg

; --- string literals single/double quotes ---
test_num = test_num + 1
s1 = 'single'
s2 = "double"
ok = 1
if s1 <> 'single' then
  ok = 0
endif
if s2 <> 'double' then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] single/double quotes' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] quote types' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 4 — String Operations
; ############################################################
filewriteln fh '=== Section 4: String Operations ==='

; --- strlen various lengths ---
test_num = test_num + 1
strlen 'Hello'
r1 = result
strlen ''
r2 = result
s = 'テラターム'
strlen s
r3 = result
ok = 1
if r1 <> 5 then
  ok = 0
endif
if r2 <> 0 then
  ok = 0
endif
if r3 <> 5 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strlen 5/0/5(UTF8)' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strlen' test_num
endif
filewriteln fh msg

; --- strconcat basic + empty ---
test_num = test_num + 1
s = 'Hello'
strconcat s ' World'
r1 = 0
if s == 'Hello World' then
  r1 = 1
endif
strconcat s ''
r2 = 0
if s == 'Hello World' then
  r2 = 1
endif
if (r1 == 1) && (r2 == 1) then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strconcat basic+empty' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strconcat' test_num
endif
filewriteln fh msg

; --- STRESS strconcat 2000 chars ---
test_num = test_num + 1
bigstr = ''
for i 1 200
  strconcat bigstr '0123456789'
next
strlen bigstr
if result == 2000 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strconcat 2000 chars' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strconcat len=%d' test_num result' test_num
endif
filewriteln fh msg

; --- strcopy basic + edge cases ---
test_num = test_num + 1
strcopy 'Hello World' 7 5 sub1
strcopy 'abcdef' 1 1 sub2
strcopy 'abcdef' 6 1 sub3
ok = 1
if sub1 <> 'World' then
  ok = 0
endif
if sub2 <> 'a' then
  ok = 0
endif
if sub3 <> 'f' then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strcopy various' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strcopy' test_num
endif
filewriteln fh msg

; --- strcompare equal/less/greater ---
test_num = test_num + 1
strcompare 'abc' 'abc'
r1 = result
strcompare 'abc' 'def'
r2 = result
strcompare 'xyz' 'abc'
r3 = result
ok = 1
if r1 <> 0 then
  ok = 0
endif
if r2 >= 0 then
  ok = 0
endif
if r3 <= 0 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strcompare eq/lt/gt' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strcompare' test_num
endif
filewriteln fh msg

; --- strscan found/not found ---
test_num = test_num + 1
strscan 'Hello World' 'World'
r1 = result
strscan 'Hello' 'XYZ'
r2 = result
ok = (r1 == 7) && (r2 == 0)
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strscan found=7, miss=0' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strscan' test_num
endif
filewriteln fh msg

; --- strmatch regex + no match ---
test_num = test_num + 1
strmatch 'Order-9876' '\d+'
r1 = result
strmatch 'abcdef' '^\d+$'
r2 = result
ok = (r1 > 0) && (r2 == 0)
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strmatch regex' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strmatch' test_num
endif
filewriteln fh msg

; --- str2int all patterns ---
test_num = test_num + 1
str2int v1 '42'
ok1 = result
str2int v2 '$FF'
str2int v3 '-99'
str2int v4 'not_a_num'
ok4 = result
ok = 1
if v1 <> 42 then
  ok = 0
endif
if ok1 <> 1 then
  ok = 0
endif
if v2 <> 255 then
  ok = 0
endif
if v3 <> -99 then
  ok = 0
endif
if ok4 <> 0 then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2int valid/hex/neg/invalid' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2int' test_num
endif
filewriteln fh msg

; --- int2str positive/negative/zero ---
test_num = test_num + 1
int2str s1 12345
int2str s2 0
int2str s3 (0 - 99)
ok = 1
if s1 <> '12345' then
  ok = 0
endif
if s2 <> '0' then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
