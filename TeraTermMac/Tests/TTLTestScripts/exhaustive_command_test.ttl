; ############################################################
;  SECTION 17 — Combined Stress Tests
; ############################################################
filewriteln fh '=== Section 17: Combined Stress Tests ==='

; --- Fibonacci(12)=144 ---
test_num = test_num + 1
a = 1
b = 1
for i 1 10
  c = a + b
  a = b
  b = c
next
if b == 144 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] Fibonacci(12)=144' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] Fibonacci=%d' test_num b' test_num
endif
filewriteln fh msg

; --- STRESS 5x5 matrix multiply ---
test_num = test_num + 1
intdim matA 25
intdim matB 25
intdim matC 25
for i 0 4
  for j 0 4
    midx = i * 5 + j
    matA[midx] = i + j
    matB[midx] = i - j + 5
    matC[midx] = 0
  next
next
for i 0 4
  for j 0 4
    cval = 0
    for k 0 4
      ai = i * 5 + k
      bj = k * 5 + j
      cval = cval + matA[ai] * matB[bj]
    next
    ci = i * 5 + j
    matC[ci] = cval
  next
next
if matC[0] == 80 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] matrix C[0,0]=80' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] matrix C[0,0]=%d' test_num matC[0]' test_num
endif
filewriteln fh msg

; --- STRESS rapid 50 file create/write ---
test_num = test_num + 1
fio_ok = 1
for fi 1 50
  sprintf2 tmpf '/tmp/ttl_exh_rapid_%d.tmp' fi
  fileopen rfh tmpf 0
  if rfh < 0 then
    fio_ok = 0
  else
    sprintf2 fline 'rapid test line %d' fi
    filewriteln rfh fline
    fileclose rfh
  endif
next
fileopen vfh '/tmp/ttl_exh_rapid_25.tmp' 0 1
filereadln vfh vline
fileclose vfh
strscan vline '25'
ok = (result > 0) && (fio_ok == 1)
for fi 1 50
  sprintf2 tmpf '/tmp/ttl_exh_rapid_%d.tmp' fi
  filedelete tmpf
next
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] rapid 50-file I/O' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] rapid file I/O' test_num
endif
filewriteln fh msg

; --- strsplit -> str2int -> sum ---
test_num = test_num + 1
strsplit '10,20,30,40,50' ',' numstrs
numsum = 0
for i 0 4
  str2int val numstrs[i]
  numsum = numsum + val
next
if numsum == 150 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] split-int-sum=150' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] split-int-sum=%d' test_num numsum' test_num
endif
filewriteln fh msg

; --- getenv -> strsplit -> strjoin ---
test_num = test_num + 1
setenv 'TTL_PATH_EXH' '/usr/bin:/usr/local/bin:/opt/bin'
getenv pval 'TTL_PATH_EXH'
strsplit pval ':' pp
strjoin newpath pp ','
if newpath == '/usr/bin,/usr/local/bin,/opt/bin' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] env-split-join' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] env-split-join' test_num
endif
filewriteln fh msg

; --- code2str chain -> Hi! ---
test_num = test_num + 1
built = ''
code2str c1 72
strconcat built c1
code2str c2 105
strconcat built c2
code2str c3 33
strconcat built c3
if built == 'Hi!' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] code2str chain' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] code2str chain' test_num
endif
filewriteln fh msg

; --- STRESS 5000-iter mod sum ---
test_num = test_num + 1
stress_acc = 0
for si 1 5000
  stress_acc = stress_acc + (si % 7)
next
if stress_acc == 14997 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 5000 mod sum=14997' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] 5000 mod sum=%d' test_num stress_acc' test_num
endif
filewriteln fh msg

; --- STRESS 100 formatted strings ---
test_num = test_num + 1
strdim fmtarr 100
for i 0 99
  sprintf2 fmtarr[i] 'item_%03d_value_%d' i (i * 3 + 7)
next
ok = 1
if fmtarr[0] <> 'item_000_value_7' then
  ok = 0
endif
if fmtarr[50] <> 'item_050_value_157' then
  ok = 0
endif
if fmtarr[99] <> 'item_099_value_304' then
  ok = 0
endif
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 100 formatted strings' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] formatted strings' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 18 — FileLock Stress
; ############################################################
filewriteln fh '=== Section 18: FileLock Stress ==='

; --- 10x filelock/fileunlock cycles ---
test_num = test_num + 1
tf = '/tmp/ttl_exh_lmulti.txt'
fileopen lmfh tf 0
filewriteln lmfh 'multi lock test'
lock_ok = 1
for li 1 10
  filelock lmfh
  if result <> 0 then
    lock_ok = 0
  endif
  fileunlock lmfh
  if result <> 0 then
    lock_ok = 0
  endif
next
fileclose lmfh
filedelete tf
if lock_ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] 10x lock/unlock' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] lock/unlock cycle' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 19 — setdate/settime Exhaustive
; ############################################################
filewriteln fh '=== Section 19: setdate/settime Exhaustive ==='

; --- setdate various formats all -1 ---
test_num = test_num + 1
setdate '2026-01-01'
r1 = result
setdate '01/01/2026'
r2 = result
setdate 'invalid'
r3 = result
setdate ''
r4 = result
ok = (r1 == -1) && (r2 == -1) && (r3 == -1) && (r4 == -1)
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] setdate all formats=-1' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] setdate format' test_num
endif
filewriteln fh msg

; --- settime various formats all -1 ---
test_num = test_num + 1
settime '12:00:00'
r1 = result
settime '99:99:99'
r2 = result
settime ''
r3 = result
ok = (r1 == -1) && (r2 == -1) && (r3 == -1)
if ok == 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] settime all formats=-1' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] settime format' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  FINAL SUMMARY
; ############################################################
filewriteln fh '============================================'
total = pass_count + fail_count
sprintf2 summary 'Total: %d tests  |  Passed: %d  |  Failed: %d' total pass_count fail_count
filewriteln fh summary
if fail_count == 0 then
  filewriteln fh 'STATUS: ALL TESTS PASSED'
else
  filewriteln fh 'STATUS: SOME TESTS FAILED'
endif
filewriteln fh '============================================'

fileclose fh
end
