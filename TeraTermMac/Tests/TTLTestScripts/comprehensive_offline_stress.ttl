dirname '/home/user/file.txt' dn
if dn = '/home/user' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] dirname="%s"' test_num dn
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] dirname got "%s"' test_num dn
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
