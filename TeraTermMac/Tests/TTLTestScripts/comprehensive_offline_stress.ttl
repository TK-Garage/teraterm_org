gethostname hn
strlen hn
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] gethostname="%s"' test_num hn
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] gethostname empty' test_num
endif
filewriteln fh msg

; 10-9 getttdir
test_num = test_num + 1
getttdir ttdir
strlen ttdir
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getttdir="%s"' test_num ttdir
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getttdir empty' test_num
endif
filewriteln fh msg

; 10-10 getspecialfolder (Desktop)
test_num = test_num + 1
getspecialfolder spdir 'Desktop'
strlen spdir
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder Desktop="%s"' test_num spdir
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder Desktop empty' test_num
endif
filewriteln fh msg

; 10-11 getipv4addr
test_num = test_num + 1
getipv4addr ipaddr
strlen ipaddr
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getipv4addr="%s"' test_num ipaddr
else
  ; may be empty if no network; treat as soft pass
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getipv4addr (no network ok)' test_num
endif
filewriteln fh msg

; 10-12 uptime
test_num = test_num + 1
uptime ut
if ut > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] uptime=%d sec' test_num ut
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] uptime=%d' test_num ut
endif
filewriteln fh msg

; 10-13 testlink (should be 0 = not connected)
test_num = test_num + 1
testlink
if result = 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] testlink=0 (offline)' test_num
else
  ; might be connected; still valid
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] testlink=%d' test_num result
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 11 — SPRINTF / SPRINTF2
; ############################################################
filewriteln fh '=== Section 11: sprintf/sprintf2 ==='

; 11-1 %s %d
test_num = test_num + 1
sprintf2 fs 'Name=%s Age=%d' 'Alice' 30
if fs = 'Name=Alice Age=30' then
