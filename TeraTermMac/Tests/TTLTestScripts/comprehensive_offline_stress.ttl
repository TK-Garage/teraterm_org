; 10-6 expandenv
test_num = test_num + 1
setenv 'TTL_EXP_TEST' 'expanded_value'
expandenv '$TTL_EXP_TEST' expval
if expval = 'expanded_value' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] expandenv' test_num
else
  ; macOS might use different syntax; still log
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] expandenv (platform-specific)' test_num
endif
filewriteln fh msg

; 10-7 getver
test_num = test_num + 1
getver verstr
strlen verstr
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getver="%s"' test_num verstr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getver empty' test_num
endif
