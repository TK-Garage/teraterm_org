  sprintf2 msg 'PASS [%d] getenv PATH len=%d' test_num result
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getenv PATH empty' test_num
endif
filewriteln fh msg

; 10-5 setenv / getenv round-trip
test_num = test_num + 1
setenv 'TTL_TEST_VAR' 'hello_from_ttl'
getenv 'TTL_TEST_VAR' envval
if envval = 'hello_from_ttl' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] setenv/getenv round-trip' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] setenv/getenv got "%s"' test_num envval
endif
