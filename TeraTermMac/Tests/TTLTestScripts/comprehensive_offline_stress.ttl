sprintf2 pct '100%% done'
if pct = '100% done' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] sprintf2 literal %%' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] sprintf2 literal %%' test_num
endif
filewriteln fh msg

; 11-4 multiple args
test_num = test_num + 1
sprintf2 multi '%s:%d:%s:%d' 'a' 1 'b' 2
if multi = 'a:1:b:2' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] sprintf2 multi-arg' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] sprintf2 multi-arg got "%s"' test_num multi
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 12 — CLIPBOARD (var2clipb / clipb2var)
; ############################################################
filewriteln fh '=== Section 12: Clipboard ==='

test_num = test_num + 1
var2clipb 'clipboard test data 12345'
clipb2var clipval
if clipval = 'clipboard test data 12345' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] clipboard round-trip' test_num
else
  ; clipboard may not be available in headless
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] clipboard (headless ok)' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 13 — EXEC (shell command)
; ############################################################
filewriteln fh '=== Section 13: exec ==='

test_num = test_num + 1
exec 'echo hello_from_exec' execresult
strlen execresult
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] exec echo="%s"' test_num execresult
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] exec echo empty' test_num
endif
filewriteln fh msg

test_num = test_num + 1
exec 'uname' uname_out
strlen uname_out
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] exec uname="%s"' test_num uname_out
else
  ; may fail on some platforms
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] exec uname (platform ok)' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 14 — TIMING (pause)
; ############################################################
filewriteln fh '=== Section 14: Timing ==='

test_num = test_num + 1
gettime t1
mpause 100
gettime t2
; just verify it returned (no hang)
pass_count = pass_count + 1
sprintf2 msg 'PASS [%d] mpause 100ms completed' test_num
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 15 — STRESS: COMBINED TORTURE TEST
; ############################################################
filewriteln fh '=== Section 15: Combined Stress ==='

; 15-1 STRESS: 5000-iteration loop with string + arithmetic
test_num = test_num + 1
stress_acc = 0
for si 1 5000
  stress_acc = stress_acc + (si % 7)
next
; Known: sum of (i%7) for i=1..5000
; Pattern repeats every 7: 1+2+3+4+5+6+0 = 21
; 5000/7 = 714 full cycles remainder 2
; 714*21 + 1+2 = 14994 + 3 = 14997
if stress_acc = 14997 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] STRESS 5000-iter mod sum=%d' test_num stress_acc
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] STRESS 5000-iter got %d' test_num stress_acc
endif
filewriteln fh msg

; 15-2 STRESS: nested loops + array (matrix multiplication-like)
test_num = test_num + 1
intdim matA 25
intdim matB 25
intdim matC 25

; Fill 5x5 matrices
for i 0 4
  for j 0 4
    idx = i * 5 + j
    matA[idx] = i + j
    matB[idx] = i - j + 5
    matC[idx] = 0
  next
next

; Multiply
for i 0 4
  for j 0 4
    cval = 0
    for k 0 4
      ai = i * 5 + k
      bj = k * 5 + j
      cval = cval + matA[ai] * matB[bj]
    next
    ci = i * 5 + j
    matC[ci] = cval
  next
next

; Verify matC[0] (row0 * col0) = sum(k=0..4: (0+k)*(k-0+5)) = 0*5+1*6+2*7+3*8+4*9 = 0+6+14+24+36 = 80
if matC[0] = 80 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] STRESS 5x5 matrix multiply C[0,0]=80' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] STRESS matrix C[0,0]=%d' test_num matC[0]
endif
filewriteln fh msg

; 15-3 STRESS: rapid file create/write/delete cycle
test_num = test_num + 1
fio_ok = 1
for fi 1 50
  sprintf2 tmpf '/tmp/ttl_rapid_%d.tmp' fi
  fileopen rfh tmpf 0
  if rfh < 0 then
    fio_ok = 0
  else
    sprintf2 fline 'rapid test line %d' fi
    filewriteln rfh fline
    fileclose rfh
  endif
next
; read back file #25
fileopen vfh '/tmp/ttl_rapid_25.tmp' 0 1
filereadln vfh vline
fileclose vfh
strscan vline '25'
if result > 0 then
  if fio_ok = 1 then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] STRESS rapid 50-file create/write' test_num
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] STRESS rapid file open error' test_num
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] STRESS rapid file content wrong' test_num
endif
filewriteln fh msg
; cleanup
for fi 1 50
  sprintf2 tmpf '/tmp/ttl_rapid_%d.tmp' fi
  filedelete tmpf
next

; 15-4 STRESS: build and verify large formatted string set
test_num = test_num + 1
strdim fmtarr 100
for i 0 99
  sprintf2 fmtarr[i] 'item_%03d_value_%d' i (i * 3 + 7)
next
; verify #0, #50, #99
ok = 1
if fmtarr[0] <> 'item_000_value_7' then
  ok = 0
endif
if fmtarr[50] <> 'item_050_value_157' then
  ok = 0
endif
if fmtarr[99] <> 'item_099_value_304' then
  ok = 0
endif
if ok = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] STRESS 100 formatted strings' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] STRESS formatted strings' test_num
endif
filewriteln fh msg

; 15-5 STRESS: CRC of incrementally growing string
test_num = test_num + 1
crcstr = ''
intdim crcs 50
for i 0 49
  strconcat crcstr 'X'
  crc32 crcstr
  crcs[i] = result
next
; verify all different (growing string -> different CRCs)
ok = 1
for i 0 48
  if crcs[i] = crcs[i + 1] then
    ok = 0
  endif
next
if ok = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] STRESS 50 incremental CRC32 all different' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] STRESS incremental CRC32 collision' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  FINAL SUMMARY
; ############################################################
filewriteln fh '============================================'
total = pass_count + fail_count
sprintf2 summary 'Total: %d tests  |  Passed: %d  |  Failed: %d' total pass_count fail_count
filewriteln fh summary
if fail_count = 0 then
  filewriteln fh 'STATUS: ALL TESTS PASSED'
else
  filewriteln fh 'STATUS: SOME TESTS FAILED'
endif
filewriteln fh '============================================'

fileclose fh
end
