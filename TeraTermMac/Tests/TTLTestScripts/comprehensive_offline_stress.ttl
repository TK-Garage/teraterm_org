; 10-1 getdate
test_num = test_num + 1
getdate dstr
strlen dstr
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getdate="%s"' test_num dstr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getdate empty' test_num
endif
