test_num = test_num + 1
gettime tstr
strlen tstr
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] gettime="%s"' test_num tstr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] gettime empty' test_num
endif
filewriteln fh msg

; 10-3 getenv HOME
test_num = test_num + 1
getenv 'HOME' hdir
strlen hdir
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getenv HOME="%s"' test_num hdir
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getenv HOME empty' test_num
endif
