sprintf2 hx 'val=0x%x' 255
if hx = 'val=0xff' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] sprintf2 hex' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] sprintf2 hex got "%s"' test_num hx
endif
filewriteln fh msg

; 11-3 %% literal
