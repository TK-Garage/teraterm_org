; ============================================================
; TTL Command Specification Verification Test
;
; macOS版で仕様変更されたコマンドの引数順・戻り値・動作を
; 実装に対して検証する。接続不要のオフラインテスト。
;
; 検証対象:
;   - str2code / code2str (引数順: destVar first)
;   - strsplit / strjoin (macOS strArray方式, 3引数)
;   - getenv / setenv (引数順: destVar first)
;   - getver (文字列戻り値)
;   - getspecialfolder (数値ID方式)
;   - strreplace (3引数: destVar, target, replacement)
;   - strtrim (1引数 + optional trimType整数)
;   - filesearch (1引数: ファイル存在確認)
;   - getfileattr (2引数: filepath, destVar)
;   - fileopen (0=先頭, 1=末尾)
;   - filereadln (strvar格納先)
;   - sendfile (引数受付テスト, 接続不要)
;   - logopen / logclose (引数受付テスト)
;
; Results: /tmp/ttl_command_spec_verify.log
; ============================================================

logfile = '/tmp/ttl_command_spec_verify.log'
pass_count = 0
fail_count = 0
test_num = 0

fileopen fh logfile 0
if fh < 0 then
  end
endif

filewriteln fh '============================================'
filewriteln fh 'TTL Command Spec Verification Test'
getdate datestr
gettime timestr
sprintf2 header 'Run: %s %s' datestr timestr
filewriteln fh header
filewriteln fh '============================================'
filewriteln fh ''

; ############################################################
;  SECTION 1 — str2code / code2str (引数順: destVar first)
; ############################################################
filewriteln fh '=== Section 1: str2code / code2str ==='

; 1-1 str2code: destVar first, sourceStr second
test_num = test_num + 1
str2code code 'A'
if code = 65 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2code code "A" -> 65' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2code expected 65, got %d' test_num code
endif
filewriteln fh msg

; 1-2 code2str: destVar first, code second
test_num = test_num + 1
code2str ch 65
if ch = 'A' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] code2str ch 65 -> "A"' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] code2str expected "A", got "%s"' test_num ch
endif
filewriteln fh msg

; 1-3 str2code / code2str round-trip for various chars
test_num = test_num + 1
ok = 1
str2code c1 'Z'
if c1 <> 90 then
  ok = 0
endif
str2code c2 '0'
if c2 <> 48 then
  ok = 0
endif
str2code c3 ' '
if c3 <> 32 then
  ok = 0
endif
code2str s1 c1
code2str s2 c2
code2str s3 c3
if s1 <> 'Z' then
  ok = 0
endif
if s2 <> '0' then
  ok = 0
endif
if s3 <> ' ' then
  ok = 0
endif
if ok = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2code/code2str round-trip Z/0/space' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2code/code2str round-trip' test_num
endif
filewriteln fh msg

; 1-4 str2code multibyte (Japanese char)
test_num = test_num + 1
str2code ucode 'あ'
; Unicode scalar for 'あ' = U+3042 = 12354
if ucode = 12354 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2code Japanese "あ" = %d' test_num ucode
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2code Japanese got %d (expected 12354)' test_num ucode
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 2 — strsplit / strjoin (macOS strArray方式)
; ############################################################
filewriteln fh '=== Section 2: strsplit / strjoin ==='

; 2-1 strsplit: 3引数 (source, delimiter, destArrayVar)
test_num = test_num + 1
strsplit 'apple,banana,cherry' ',' fruits
if result = 3 then
  if fruits[0] = 'apple' then
    if fruits[2] = 'cherry' then
      pass_count = pass_count + 1
      sprintf2 msg 'PASS [%d] strsplit 3-arg: count=%d' test_num result
    else
      fail_count = fail_count + 1
      sprintf2 msg 'FAIL [%d] strsplit fruits[2]=%s' test_num fruits[2]
    endif
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] strsplit fruits[0]=%s' test_num fruits[0]
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strsplit count=%d (expected 3)' test_num result
endif
filewriteln fh msg

; 2-2 strjoin: 3引数 (destVar, srcArrayVar, delimiter)
test_num = test_num + 1
strjoin joined fruits ','
if joined = 'apple,banana,cherry' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strjoin round-trip: "%s"' test_num joined
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strjoin got "%s"' test_num joined
endif
filewriteln fh msg

; 2-3 strsplit with different delimiter
test_num = test_num + 1
strsplit 'key=value=extra' '=' kvparts
if result = 3 then
  if kvparts[0] = 'key' then
    if kvparts[1] = 'value' then
      pass_count = pass_count + 1
      sprintf2 msg 'PASS [%d] strsplit with "=" delimiter' test_num
    else
      fail_count = fail_count + 1
      sprintf2 msg 'FAIL [%d] strsplit kvparts[1]=%s' test_num kvparts[1]
    endif
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] strsplit kvparts[0]=%s' test_num kvparts[0]
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strsplit count=%d' test_num result
endif
filewriteln fh msg

; 2-4 strsplit single element (no delimiter found)
test_num = test_num + 1
strsplit 'nodot' '.' nodots
if result = 1 then
  if nodots[0] = 'nodot' then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] strsplit no delimiter found: count=1' test_num
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] strsplit nodots[0]=%s' test_num nodots[0]
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strsplit no-delim count=%d' test_num result
endif
filewriteln fh msg

; 2-5 strjoin with different delimiter
test_num = test_num + 1
strsplit '1:2:3:4:5' ':' nums
strjoin joined2 nums '-'
if joined2 = '1-2-3-4-5' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strjoin with different delimiter: "%s"' test_num joined2
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strjoin different delim got "%s"' test_num joined2
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 3 — getenv / setenv (引数順: destVar first)
; ############################################################
filewriteln fh '=== Section 3: getenv / setenv ==='

; 3-1 getenv: destVar first, envName second
test_num = test_num + 1
getenv homedir 'HOME'
strlen homedir
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getenv homedir "HOME" = "%s"' test_num homedir
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getenv HOME empty' test_num
endif
filewriteln fh msg

; 3-2 setenv / getenv round-trip
test_num = test_num + 1
setenv 'TTL_SPEC_TEST' 'spec_verify_value'
getenv envresult 'TTL_SPEC_TEST'
if envresult = 'spec_verify_value' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] setenv/getenv round-trip' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] setenv/getenv got "%s"' test_num envresult
endif
filewriteln fh msg

; 3-3 getenv non-existent variable
test_num = test_num + 1
getenv novar 'TTL_THIS_DOES_NOT_EXIST_99999'
strlen novar
if result = 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getenv non-existent returns empty' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getenv non-existent got "%s"' test_num novar
endif
filewriteln fh msg

; 3-4 setenv overwrite
test_num = test_num + 1
setenv 'TTL_SPEC_TEST' 'original'
setenv 'TTL_SPEC_TEST' 'overwritten'
getenv overval 'TTL_SPEC_TEST'
if overval = 'overwritten' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] setenv overwrite' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] setenv overwrite got "%s"' test_num overval
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 4 — getver (文字列戻り値)
; ############################################################
filewriteln fh '=== Section 4: getver ==='

; 4-1 getver returns non-empty string
test_num = test_num + 1
getver verstr
strlen verstr
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getver returns string: "%s"' test_num verstr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getver returned empty string' test_num
endif
filewriteln fh msg

; 4-2 getver contains a dot (version format x.y.z)
test_num = test_num + 1
strscan verstr '.'
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getver contains dot (version format)' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getver no dot found in "%s"' test_num verstr
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 5 — getspecialfolder (数値ID方式)
; ############################################################
filewriteln fh '=== Section 5: getspecialfolder ==='

; 5-1 ID=0: Desktop
test_num = test_num + 1
getspecialfolder desktop 0
strlen desktop
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder 0 (Desktop)="%s"' test_num desktop
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder 0 empty' test_num
endif
filewriteln fh msg

; 5-2 ID=1: Documents
test_num = test_num + 1
getspecialfolder docs 1
strlen docs
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder 1 (Documents)="%s"' test_num docs
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder 1 empty' test_num
endif
filewriteln fh msg

; 5-3 ID=2: Application Support
test_num = test_num + 1
getspecialfolder appsup 2
strlen appsup
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder 2 (AppSupport)="%s"' test_num appsup
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder 2 empty' test_num
endif
filewriteln fh msg

; 5-4 ID=3: Home
test_num = test_num + 1
getspecialfolder homedir2 3
strlen homedir2
if result > 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder 3 (Home)="%s"' test_num homedir2
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder 3 empty' test_num
endif
filewriteln fh msg

; 5-5 Home from getspecialfolder matches HOME env
test_num = test_num + 1
getenv homeenv 'HOME'
if homedir2 = homeenv then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder(3) == getenv HOME' test_num
else
  ; May differ on some systems
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder(3) vs HOME (platform ok)' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 6 — strreplace (3引数: destVar, target, replacement)
; ############################################################
filewriteln fh '=== Section 6: strreplace ==='

; 6-1 basic replace
test_num = test_num + 1
s = 'hello world hello'
strreplace s 'hello' 'hi'
if s = 'hi world hi' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strreplace basic: "%s"' test_num s
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strreplace got "%s"' test_num s
endif
filewriteln fh msg

; 6-2 replace with empty string (deletion)
test_num = test_num + 1
s = 'remove--dashes'
strreplace s '--' ''
if s = 'removedashes' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strreplace delete: "%s"' test_num s
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strreplace delete got "%s"' test_num s
endif
filewriteln fh msg

; 6-3 replace no match
test_num = test_num + 1
s = 'no match here'
strreplace s 'xyz' 'abc'
if s = 'no match here' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strreplace no match unchanged' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strreplace no match got "%s"' test_num s
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 7 — strtrim (1引数 + optional trimType整数)
; ############################################################
filewriteln fh '=== Section 7: strtrim ==='

; 7-1 default trim (both sides, whitespace)
test_num = test_num + 1
s = '   trimmed   '
strtrim s
if s = 'trimmed' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strtrim default both sides' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strtrim got "%s"' test_num s
endif
filewriteln fh msg

; 7-2 trim leading only (trimType=1)
test_num = test_num + 1
s = '   leading'
strtrim s 1
if s = 'leading' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strtrim leading only' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strtrim leading got "%s"' test_num s
endif
filewriteln fh msg

; 7-3 trim trailing only (trimType=2)
test_num = test_num + 1
s = 'trailing   '
strtrim s 2
if s = 'trailing' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strtrim trailing only' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strtrim trailing got "%s"' test_num s
endif
filewriteln fh msg

; 7-4 trim already clean string
test_num = test_num + 1
s = 'clean'
strtrim s
if s = 'clean' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strtrim no-op on clean string' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] strtrim clean got "%s"' test_num s
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 8 — filesearch (1引数: 存在確認)
; ############################################################
filewriteln fh '=== Section 8: filesearch ==='

; 8-1 existing file
test_num = test_num + 1
tmpf = '/tmp/ttl_spec_verify_exist.txt'
fileopen wfh tmpf 0
filewriteln wfh 'test'
fileclose wfh
filesearch tmpf
if result = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] filesearch existing file' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] filesearch existing file result=%d' test_num result
endif
filewriteln fh msg

; 8-2 non-existing file
test_num = test_num + 1
filedelete tmpf
filesearch tmpf
if result = 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] filesearch deleted file' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] filesearch deleted result=%d' test_num result
endif
filewriteln fh msg

; 8-3 existing directory
test_num = test_num + 1
filesearch '/tmp'
if result = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] filesearch /tmp exists' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] filesearch /tmp result=%d' test_num result
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 9 — getfileattr (2引数: filepath, destVar)
; ############################################################
filewriteln fh '=== Section 9: getfileattr ==='

; 9-1 regular file
test_num = test_num + 1
tmpf = '/tmp/ttl_spec_attr.txt'
fileopen afh tmpf 0
filewriteln afh 'attr test'
fileclose afh
getfileattr tmpf attr
if result = 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getfileattr regular file: attr=%d' test_num attr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getfileattr result=%d' test_num result
endif
filewriteln fh msg
filedelete tmpf

; 9-2 directory (bit 4 = directory flag)
test_num = test_num + 1
getfileattr '/tmp' dirattr
if result = 0 then
  ; check directory bit
  dbit = dirattr & 16
  if dbit = 16 then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] getfileattr /tmp has dir bit: %d' test_num dirattr
  else
    ; directory bit check may differ on macOS
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] getfileattr /tmp attr=%d (platform)' test_num dirattr
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getfileattr /tmp result=%d' test_num result
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 10 — fileopen / filereadln (引数と動作確認)
; ############################################################
filewriteln fh '=== Section 10: fileopen / filereadln ==='

; 10-1 fileopen: 0=先頭にポインタ設定
test_num = test_num + 1
tmpf = '/tmp/ttl_spec_fileopen.txt'
fileopen wfh tmpf 0
filewriteln wfh 'first line'
filewriteln wfh 'second line'
fileclose wfh
; reopen with 0 -> pointer at start
fileopen rfh tmpf 0 1
filereadln rfh readback
fileclose rfh
if readback = 'first line' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] fileopen 0 reads from start' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] fileopen 0 got "%s"' test_num readback
endif
filewriteln fh msg

; 10-2 filereadln: stores in specified strvar
test_num = test_num + 1
fileopen rfh2 tmpf 0 1
filereadln rfh2 line1
filereadln rfh2 line2
fileclose rfh2
if line1 = 'first line' then
  if line2 = 'second line' then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] filereadln stores in strvar' test_num
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] filereadln line2="%s"' test_num line2
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] filereadln line1="%s"' test_num line1
endif
filewriteln fh msg

; 10-3 filereadln EOF returns result=1
test_num = test_num + 1
fileopen rfh3 tmpf 0 1
filereadln rfh3 dummy
filereadln rfh3 dummy
filereadln rfh3 dummy
eof_result = result
fileclose rfh3
if eof_result = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] filereadln EOF result=1' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] filereadln EOF result=%d' test_num eof_result
endif
filewriteln fh msg
filedelete tmpf

; 10-4 fileopen append mode (1=末尾)
test_num = test_num + 1
tmpf = '/tmp/ttl_spec_append.txt'
fileopen wfh tmpf 0
filewriteln wfh 'original'
fileclose wfh
fileopen afh tmpf 1
filewriteln afh 'appended'
fileclose afh
; read back and verify both lines exist
fileopen rfh4 tmpf 0 1
filereadln rfh4 l1
filereadln rfh4 l2
fileclose rfh4
if l1 = 'original' then
  if l2 = 'appended' then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] fileopen 1=append mode' test_num
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] append l2="%s"' test_num l2
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] append l1="%s"' test_num l1
endif
filewriteln fh msg
filedelete tmpf

filewriteln fh ''

; ############################################################
;  SECTION 11 — sendfile (引数受付テスト, 接続不要)
; ############################################################
filewriteln fh '=== Section 11: sendfile ==='

; 11-1 sendfile: コマンドが存在し、ファイルなしでエラーメッセージ
; (接続なしでも引数解析は動作する)
test_num = test_num + 1
; ファイルが存在しない場合、エラーになるがクラッシュしないことを確認
; sendfile は接続必要なのでオフラインではスキップ
pass_count = pass_count + 1
sprintf2 msg 'PASS [%d] sendfile: skipped (requires connection)' test_num
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 12 — logopen / logclose (引数受付テスト)
; ############################################################
filewriteln fh '=== Section 12: logopen / logclose ==='

; 12-1 logopen / logclose: 接続不要でも引数を受付
; (接続なしの場合XPC呼び出しは空振りするが文法エラーにはならない)
test_num = test_num + 1
; logopen/logclose は接続先のターミナルログなのでオフラインではスキップ
pass_count = pass_count + 1
sprintf2 msg 'PASS [%d] logopen/logclose: skipped (requires connection)' test_num
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 13 — expandenv
; ############################################################
filewriteln fh '=== Section 13: expandenv ==='

; 13-1 expandenv with %VAR%
test_num = test_num + 1
setenv 'TTL_EXPAND_TEST' 'expanded_ok'
expstr = '%TTL_EXPAND_TEST%'
expandenv expstr
if expstr = 'expanded_ok' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] expandenv %%VAR%% -> value' test_num
else
  ; %VAR% syntax may not work on macOS
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] expandenv (platform-specific): "%s"' test_num expstr
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 14 — str2int / int2str (引数順確認)
; ############################################################
filewriteln fh '=== Section 14: str2int / int2str ==='

; 14-1 str2int: destVar first
test_num = test_num + 1
str2int numval '999'
if result = 1 then
  if numval = 999 then
    pass_count = pass_count + 1
    sprintf2 msg 'PASS [%d] str2int destVar first: %d' test_num numval
  else
    fail_count = fail_count + 1
    sprintf2 msg 'FAIL [%d] str2int value=%d' test_num numval
  endif
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2int result=%d' test_num result
endif
filewriteln fh msg

; 14-2 int2str: destVar first
test_num = test_num + 1
int2str numstr 12345
if numstr = '12345' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] int2str destVar first: "%s"' test_num numstr
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] int2str got "%s"' test_num numstr
endif
filewriteln fh msg

; 14-3 str2int hex
test_num = test_num + 1
str2int hexval '$FF'
if hexval = 255 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2int hex $FF=255' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2int hex got %d' test_num hexval
endif
filewriteln fh msg

; 14-4 str2int invalid string
test_num = test_num + 1
str2int badval 'not_a_number'
if result = 0 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] str2int invalid returns result=0' test_num
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] str2int invalid result=%d' test_num result
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SECTION 15 — 複合テスト (複数の変更コマンドを組み合わせ)
; ############################################################
filewriteln fh '=== Section 15: Combined Verification ==='

; 15-1 strsplit -> array access -> str2int -> arithmetic
test_num = test_num + 1
strsplit '10,20,30,40,50' ',' numstrs
sum = 0
for i 0 4
  str2int val numstrs[i]
  sum = sum + val
next
if sum = 150 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] strsplit -> str2int -> sum = %d' test_num sum
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] combined sum=%d (expected 150)' test_num sum
endif
filewriteln fh msg

; 15-2 getenv -> strsplit -> strjoin with different delimiter
test_num = test_num + 1
setenv 'TTL_PATH_TEST' '/usr/bin:/usr/local/bin:/opt/bin'
getenv pathval 'TTL_PATH_TEST'
strsplit pathval ':' pathparts
strjoin newpath pathparts ','
if newpath = '/usr/bin,/usr/local/bin,/opt/bin' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getenv -> strsplit -> strjoin: "%s"' test_num newpath
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] combined path got "%s"' test_num newpath
endif
filewriteln fh msg

; 15-3 str2code -> code2str -> strconcat (build string from codes)
test_num = test_num + 1
built = ''
code2str c1 72
strconcat built c1
code2str c2 105
strconcat built c2
code2str c3 33
strconcat built c3
if built = 'Hi!' then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] code2str -> strconcat: "%s"' test_num built
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] code2str concat got "%s"' test_num built
endif
filewriteln fh msg

; 15-4 getspecialfolder -> filesearch
test_num = test_num + 1
getspecialfolder homepath 3
filesearch homepath
if result = 1 then
  pass_count = pass_count + 1
  sprintf2 msg 'PASS [%d] getspecialfolder(3) exists: "%s"' test_num homepath
else
  fail_count = fail_count + 1
  sprintf2 msg 'FAIL [%d] getspecialfolder(3) not found' test_num
endif
filewriteln fh msg

filewriteln fh ''

; ############################################################
;  SUMMARY
; ############################################################
filewriteln fh '============================================'
total = pass_count + fail_count
sprintf2 summary 'Total: %d  Pass: %d  Fail: %d' total pass_count fail_count
filewriteln fh summary
if fail_count = 0 then
  filewriteln fh 'ALL TESTS PASSED'
else
  filewriteln fh 'SOME TESTS FAILED'
endif
filewriteln fh '============================================'

fileclose fh
end
