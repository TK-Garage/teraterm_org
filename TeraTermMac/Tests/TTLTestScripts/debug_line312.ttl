; ============================================================
; Debug TTL — Reproduce "Error at line 312: Variable not initialized"
;
; This script isolates the strsplit/strjoin issue found in
; comprehensive_offline_stress.ttl (lines 312-313).
;
; Original TeraTerm strsplit syntax:
;   strsplit <source_string> <delimiter> [<count>]
;   -> result = element count
;   -> groupmatchstr1..groupmatchstr9 = split parts
;
; Original TeraTerm strjoin syntax:
;   strjoin <dest_var> <delimiter> [<count>]
;   -> dest_var = joined string from groupmatchstr1..9
; ============================================================

logfile = '/tmp/ttl_debug_line312.log'
fileopen fh logfile 0
filewriteln fh '=== Debug: strsplit/strjoin issue ==='
filewriteln fh ''

; --- Test 1: Explanation of original syntax ---
filewriteln fh 'Test 1: Original TeraTerm syntax uses groupmatchstr1..9'

; --- Test 2: Correct strsplit usage (groupmatchstr) ---
filewriteln fh ''
filewriteln fh 'Test 2: Correct strsplit usage'

strsplit 'a,b,c,d' ','
sprintf2 msg '  result (count) = %d' result
filewriteln fh msg
sprintf2 msg '  groupmatchstr1 = "%s"' groupmatchstr1
filewriteln fh msg
sprintf2 msg '  groupmatchstr2 = "%s"' groupmatchstr2
filewriteln fh msg
sprintf2 msg '  groupmatchstr3 = "%s"' groupmatchstr3
filewriteln fh msg
sprintf2 msg '  groupmatchstr4 = "%s"' groupmatchstr4
filewriteln fh msg

if result = 4 then
  filewriteln fh '  -> PASS: strsplit returned 4 elements'
else
  sprintf2 msg '  -> FAIL: expected 4, got %d' result
  filewriteln fh msg
endif

if groupmatchstr1 = 'a' then
  filewriteln fh '  -> PASS: groupmatchstr1 = "a"'
else
  sprintf2 msg '  -> FAIL: groupmatchstr1 = "%s"' groupmatchstr1
  filewriteln fh msg
endif

; --- Test 3: Correct strjoin usage (groupmatchstr) ---
filewriteln fh ''
filewriteln fh 'Test 3: Correct strjoin usage'

strjoin rejoined ',' 4
sprintf2 msg '  rejoined = "%s"' rejoined
filewriteln fh msg

if rejoined = 'a,b,c,d' then
  filewriteln fh '  -> PASS: round-trip strsplit/strjoin matches'
else
  filewriteln fh '  -> FAIL: round-trip mismatch'
endif

; --- Test 4: Verify with different delimiter ---
filewriteln fh ''
filewriteln fh 'Test 4: Split then join with colon delimiter'

strsplit 'x:y:z' ':'
sprintf2 msg '  split count = %d' result
filewriteln fh msg

if result = 3 then
  strjoin rebuilt ':' 3
  sprintf2 msg '  rebuilt = "%s"' rebuilt
  filewriteln fh msg
  if rebuilt = 'x:y:z' then
    filewriteln fh '  -> PASS'
  else
    filewriteln fh '  -> FAIL'
  endif
endif

; --- Summary ---
filewriteln fh ''
filewriteln fh '=== Debug complete ==='
fileclose fh

end
